rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['admin@pointinscript.app'];
    }
    function isInspecteur() {
      return isSignedIn() && request.auth.token.email in ['ieppgrabo@pointinscript.app'];
    }
    function mySchoolId() {
      return exists(/databases/$(database)/documents/userSchools/$(request.auth.uid))
        ? get(/databases/$(database)/documents/userSchools/$(request.auth.uid)).data.schoolId
        : null;
    }
    // Garde-fous d'écriture : nombres >= 0, textes bornés, pas de clés sensibles
    function numOk(v) { return v == null || (v is number && v >= 0 && v <= 100000); }
    function strOk(v) { return v == null || (v is string && v.size() <= 2000); }
    function validPointReport() {
      let d = request.resource.data;
      return d.schoolId is string
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.year is string
        && numOk(d.get('pre_enfants', null))
        && numOk(d.get('pre_inscrits_total', null))
        && numOk(d.get('pre_avec_extrait', null))
        && numOk(d.get('pre_avec_extrait_filles', null))
        && numOk(d.get('pre_sans_extrait', null))
        && numOk(d.get('pre_sans_extrait_filles', null))
        && numOk(d.get('pre_inscrits_filles', null))
        && numOk(d.get('pre_handicap_avec', null))
        && numOk(d.get('pre_handicap_sans', null))
        && numOk(d.get('pre_non_inscrits_total', null))
        && numOk(d.get('pre_non_inscrits_filles', null))
        && numOk(d.get('prim_eleves', null))
        && numOk(d.get('prim_inscrits_total', null))
        && numOk(d.get('prim_avec_extrait', null))
        && numOk(d.get('prim_avec_extrait_filles', null))
        && numOk(d.get('prim_sans_extrait', null))
        && numOk(d.get('prim_sans_extrait_filles', null))
        && numOk(d.get('prim_inscrits_filles', null))
        && numOk(d.get('prim_handicap_avec', null))
        && numOk(d.get('prim_handicap_sans', null))
        && numOk(d.get('prim_non_inscrits_total', null))
        && numOk(d.get('prim_non_inscrits_filles', null))
        && strOk(d.get('pre_motifs', null))
        && strOk(d.get('prim_motifs', null))
        && strOk(d.get('observations', null))
        && strOk(d.get('difficultes', null))
        && strOk(d.get('dispositions', null))
        && !('username' in d) && !('password' in d) && !('uid' in d);
    }
    match /secteurs/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /ecoles/{id} {
      allow get: if isSignedIn() && (isAdmin() || isInspecteur() || id == mySchoolId());
      allow list: if isAdmin() || isInspecteur();
      allow create, update, delete: if isAdmin();
    }
    // Secrets de connexion directeurs — admin uniquement (jamais dans ecoles)
    match /loginSecrets/{id} {
      allow read, write: if isAdmin();
    }
    match /userSchools/{id} {
      allow read: if isAdmin() || isInspecteur() || request.auth.uid == id;
      allow write: if isAdmin();
    }
    match /reports/{id} {
      allow read: if isAdmin() || isInspecteur() || (isSignedIn() && resource.data.schoolId == mySchoolId());
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.schoolId == mySchoolId() && validPointReport());
      allow update: if isAdmin() || (isSignedIn() && resource.data.schoolId == mySchoolId() && request.resource.data.schoolId == resource.data.schoolId && validPointReport());
      allow delete: if isAdmin();
    }
  }
}
